# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Models / API ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
LOCAL_MODEL=qwen3:30b-a3b
LOCAL_MODEL_FAST=qwen3:8b
LOCAL_MODEL_TINY=qwen3:4b
VISION_MODEL=moondream
EMBED_MODEL=all-minilm
WHISPER_MODEL=base.en

# --- Ollama endpoint ---
# Where the local Ollama daemon listens. Leave as the default unless you run it
# elsewhere. (Cloud-suffixed models are still served through this local daemon.)
OLLAMA_URL=http://localhost:11434

# --- Phase 1 local tool calling ---
# When false, the local path never sends tool definitions (original behavior).
TOOL_CALLING_ENABLED=true
# Max number of tool calls allowed per user turn (every call, incl. rejected, counts).
MAX_TOOL_STEPS=5
# Default per-tool execution timeout, in seconds.
DEFAULT_TOOL_TIMEOUT_SECONDS=10

# --- Phase 2A read-only internet & GitHub tools ---
# Master switch: when false, the 7 internet/GitHub tools are not offered to the model.
INTERNET_TOOLS_ENABLED=true
# Capability gate: when false, internet tools are visible but blocked at execution.
INTERNET_READ_ENABLED=true

# Web search (Tavily). Without a key, browser.search returns a controlled
# "search API key missing" error; the other tools still work.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# GitHub REST API. Optional for public repos (higher rate limits with a token).
# Use a READ-ONLY, least-privilege token. Never commit a real token.
GITHUB_TOKEN=

# HTTP fetching (browser.fetch_page)
HTTP_USER_AGENT=Local-LLM-Project/1.0
ALLOW_HTTP_FETCH=false
SEARCH_MAX_RESULTS=10
MAX_SEARCH_QUERY_CHARS=500
BROWSER_CONNECT_TIMEOUT_SECONDS=5
BROWSER_READ_TIMEOUT_SECONDS=20
BROWSER_MAX_REDIRECTS=5
MAX_PAGE_BYTES=2000000
MAX_PAGE_CHARS=30000

# GitHub limits
GITHUB_TIMEOUT_SECONDS=20
GITHUB_MAX_FILE_BYTES=1000000
GITHUB_MAX_FILE_CHARS=30000
GITHUB_MAX_DIRECTORY_ENTRIES=200
GITHUB_MAX_RELEASES=10

# --- Phase 2B: controlled clone + static repository inspection ---
# OFF by default. Cloning only ever clones validated PUBLIC GitHub repos into the
# controlled root below. Repositories are NEVER executed, imported, or installed.
REPOSITORY_CLONE_ENABLED=false
# Enables the repo.* inspection tools for already-cloned repos (implied when cloning is on).
REPOSITORY_INSPECTION_ENABLED=false
# Controlled workspace root for clones (gitignored). Computed as <root>/<owner>/<repo>.
REPOSITORY_ROOT=data/repositories
GIT_EXECUTABLE=git
GIT_CLONE_TIMEOUT_SECONDS=120
# Preflight (GitHub-reported size, KB) and post-clone enforcement.
MAX_REPOSITORY_PREFLIGHT_SIZE_KB=200000
MAX_CLONED_REPOSITORY_SIZE_MB=250
MAX_CLONED_REPOSITORY_FILES=25000
# repo.list_files / repo.read_file bounds.
REPO_MAX_LIST_ENTRIES=500
REPO_MAX_LIST_DEPTH=5
REPO_MAX_READ_BYTES=1000000
REPO_MAX_READ_CHARS=30000
# repo.security_scan bounds.
REPO_SCAN_MAX_FILES=5000
REPO_SCAN_MAX_FILE_BYTES=500000
REPO_SCAN_MAX_TOTAL_BYTES=50000000
REPO_SCAN_MAX_DEPTH=20
REPO_SCAN_MAX_FINDINGS=500

# --- Tapo C236 network camera (RTSP capture) ---
TAPO_CAMERA_HOST=10.0.0.65
TAPO_CAMERA_PORT=554
TAPO_CAMERA_USERNAME=
TAPO_CAMERA_PASSWORD=
TAPO_CAMERA_STREAM=stream1
TAPO_CAMERA_NAME=office
TAPO_CAMERA_CAPTURE_DIR=artifacts/camera

# --- Optional: ONVIF pan/tilt (PTZ). Off by default. ---
# The ONVIF service port is NOT the RTSP port (554). Requires: pip install onvif-zeep
# For Tapo C236, ONVIF is commonly on port 2020 — confirm with a read-only probe first.
TAPO_ONVIF_ENABLED=false
TAPO_ONVIF_PORT=2020
TAPO_ONVIF_USERNAME=
TAPO_ONVIF_PASSWORD=

# --- Phase H.1: stock analysis (market data, cache, quota, DCF) ---
# Alpha Vantage is reached by a TRUSTED LOCAL tool over the project's existing
# SSRF-safe fetch path, NOT by an MCP server. See
# docs/security/ALPHAVANTAGE_PROVIDER_REVIEW.md for why both candidate Alpha
# Vantage MCP servers were reviewed and rejected.
#
# The key is read at call time and is never written to a cache key, a cache
# record, a log line, an exception message, or a test snapshot.
ALPHAVANTAGE_API_KEY=
MARKET_DATA_ENABLED=true
STOCK_ANALYSIS_ENABLED=true

# Estimated daily external-call budget. This is NOT a claim about your plan —
# a provider rate-limit response is always treated as authoritative and will
# stop further calls regardless of this number. Free tier is commonly 25/day.
ALPHAVANTAGE_DAILY_CALL_LIMIT=25

# Cache location and policy.
MARKET_DATA_CACHE_ENABLED=true
MARKET_DATA_CACHE_PATH=app_data/finance_cache/market_data.sqlite3
# How far past expiry a cached record may still be served when a refresh fails.
# Serving one is always reported as STALE, never as fresh.
MARKET_DATA_STALE_IF_ERROR_SECONDS=604800
MARKET_DATA_NEGATIVE_TTL_SECONDS=3600

# Retries. Only transient transport failures are retried; quota, rate-limit,
# auth, entitlement and invalid-symbol responses never are.
MARKET_DATA_MAX_RETRIES=2
MARKET_DATA_RETRY_BASE_DELAY_MS=500

# Analysis defaults.
STOCK_ANALYSIS_INCLUDE_NEWS=false
STOCK_ANALYSIS_FORECAST_YEARS=5
# H.4 corrective patch: default report length/detail. "compact" (~800-1,500
# words: Status/Snapshot/Valuation/Technical/Bull/Bear/Risk/Research View/
# Sources) or "full" (today's original, complete report — bull/bear/rebuttal
# transcript, full assumption provenance, full sensitivity grid). Nothing
# computed internally changes with this setting, only what is RENDERED — see
# finance/workflow.py::render_compact_report / synthesize_report. A request
# explicitly asking for a "detailed"/"full" report overrides this for that
# one request regardless of the configured default.
STOCK_ANALYSIS_REPORT_DETAIL=compact
STOCK_ANALYSIS_COMPACT_REPORT_TARGET_WORDS=1500
# GE corrective patch: wall-clock timeout for the report_detail="full"
# single-shot narrative call (finance/workflow.py::_ask_local_with_content_
# policy) and its one repair attempt. This call's prompt is the full compact
# payload and its completion has no options.num_predict cap (unlike a
# RESEARCH_STAGE_* call above), making it this codebase's single largest
# local-model call — a live run hit an actual read timeout at the previous
# unconfigured 120s default on exactly this path.
STOCK_ANALYSIS_SYNTHESIS_TIMEOUT_SECONDS=240
DCF_MIN_FORECAST_YEARS=1
DCF_MAX_FORECAST_YEARS=15
DCF_MIN_DISCOUNT_RATE=0.01
DCF_MAX_DISCOUNT_RATE=0.60

# Minimum spacing between EXTERNAL provider calls, process-wide. The free tier
# allows roughly 1 request/second and a full analysis fires ~7 datasets, so
# pacing them is cheaper than tripping the throttle and retrying. Cache hits
# bypass this entirely.
MARKET_DATA_MIN_REQUEST_INTERVAL_MS=1200

# --- Accuracy patch: net-debt policy, ROE/GAAP labeling, compact synthesis ---
# Net-debt policy for the DCF equity bridge. "cash_only" (default, conservative)
# nets total debt against cash and cash equivalents alone. The alternate
# "cash_and_marketable_securities" ALSO nets off short-term investments, but
# only when explicitly marked eligible below — this project never infers
# per-security liquidity on its own. See finance/dcf.py::NetDebtPolicy.
DCF_NET_DEBT_POLICY=cash_only
DCF_SHORT_TERM_INVESTMENTS_ELIGIBLE=false

# --- Phase H.3 corrective patch: CapEx/D&A/working-capital assumption
# hierarchy (finance/workflow.py::propose_assumptions) --- reported historical
# ratios are ALWAYS preferred; these defaults are the LAST-RESORT fallback,
# used only when NO reported history exists at all (never derived from a
# margin difference or any other proxy). How many recent annual periods the
# historical-ratio average may look back across.
DCF_ASSUMPTION_HISTORY_MAX_YEARS=5
DCF_DEFAULT_CAPEX_PCT_REVENUE=0.05
DCF_DEFAULT_DEPRECIATION_PCT_REVENUE=0.04
DCF_DEFAULT_WORKING_CAPITAL_PCT_REVENUE=0.02

# --- TSLA DCF validation patch: post-hoc result validation (finance/dcf.py::
# DcfValidationStatus) --- run_dcf() always computes a result when the
# arithmetic is finite, but classifies it: a negative terminal-year FCFF fed
# into the Gordon-growth perpetuity does not represent a going concern that
# grows forever, so it is flagged invalid rather than silently perpetuity-
# valued unless this is explicitly turned on. The monotonicity check compares
# bull >= base >= bear ONLY when scenario names are exactly base/bull/bear and
# their assumptions are constructed to imply that ordering — it only ever
# DETECTS a violation, never reorders or clamps a value.
DCF_ALLOW_NEGATIVE_TERMINAL_FCFF=false
DCF_SCENARIO_MONOTONICITY_CHECK_ENABLED=true

# Compact synthesis payload bounds (what actually reaches the local LLM's
# prompt — see finance/workflow.py::build_compact_synthesis_payload). The full,
# unbounded result is always available in AnalysisResult.facts regardless.
STOCK_ANALYSIS_COMPACT_HISTORY_YEARS=5
STOCK_ANALYSIS_COMPACT_PRICE_OBSERVATIONS=10
STOCK_ANALYSIS_COMPACT_MAX_WARNINGS=20
STOCK_ANALYSIS_COMPACT_MAX_PROVENANCE_ENTRIES=20
STOCK_ANALYSIS_EARNINGS_MAX_ANNUAL=5
STOCK_ANALYSIS_EARNINGS_MAX_QUARTERLY=8

# --- Staged research pipeline (finance/research_pipeline.py) ---
# Role structure adapted from TauricResearch/TradingAgents (reviewed at pinned
# commit a33fd4c0f134485a43553a2c23a63cb14adbd88f, Apache-2.0) — independent
# bull/bear researchers, one bounded rebuttal round, research-manager
# reconciliation, risk review, FinalInvestmentSynthesizer. NOT a runtime
# dependency on TradingAgents, no LangGraph. See
# docs/PHASE_H2_RESEARCH_PIPELINE.md. Every stage is a separate local-model
# call with no tools and no network access; disabling this falls back to
# today's single-shot report (still includes its own Research Stance section
# — research characterization only, never a buy/sell/hold/avoid verdict).
STOCK_ANALYSIS_RESEARCH_PIPELINE_ENABLED=true
# Per-stage output cap (Ollama options.num_predict) and wall-clock timeout —
# a stage that exceeds either fails closed (see finance/research_pipeline.py
# ::_run_stage) rather than producing an unbounded or hanging call.
RESEARCH_STAGE_MAX_OUTPUT_TOKENS=12000
RESEARCH_STAGE_TIMEOUT_SECONDS=180
# How many times one stage may be attempted before it fails closed (WM
# corrective patch). Each attempt gets a correction targeted at what
# actually went wrong: truncated output, malformed JSON, an unknown
# evidence id, a schema error, or a content-policy violation. Set to 1
# to restore the old single-attempt behaviour.
RESEARCH_STAGE_MAX_ATTEMPTS=3
# Phase H.3 corrective patch (Problem 10): ceilings self-reported confidence
# is clamped DOWN to (never up, never rejected) whenever a material dataset
# was omitted from the analysis — the prompts already ask the model to lower
# its own confidence in this case; these are the deterministic backstop.
RESEARCH_REDUCED_MODE_CONFIDENCE_CAP=0.6
RESEARCH_REDUCED_MODE_CONFIDENCE_ENUM_CAP=medium

# --- Phase H.3: Yahoo Finance (yfinance) + SEC EDGAR providers ---
# See docs/security/YAHOO_SEC_PROVIDER_REVIEW.md for the full review. Yahoo
# is UNOFFICIAL personal-use scraping (no sanctioned API, no key) — OFF by
# default until explicitly acknowledged. SEC EDGAR is an official, documented,
# keyless government API gated only by a required identifying User-Agent and
# a published 10 req/s fair-access ceiling.
YAHOO_FINANCE_ENABLED=true
# Must be explicitly true or Yahoo tools fail closed with a controlled error
# even though YAHOO_FINANCE_ENABLED=true — unofficial scraping needs an
# explicit opt-in, never just "not disabled". Pinned yfinance version: 1.5.2.
YAHOO_PERSONAL_USE_ACKNOWLEDGED=false
SEC_EDGAR_ENABLED=true
# Required for every SEC EDGAR request (SEC rejects requests without one).
# Format: "AppName contact@email" — never hardcode this in source; it is
# excluded from logs/cache keys/exceptions/snapshots the same way
# ALPHAVANTAGE_API_KEY is, even though it is not a secret in the same sense.
SEC_USER_AGENT=
# Paced well under SEC's published 10 req/s ceiling.
SEC_MIN_REQUEST_INTERVAL_MS=250
# The ticker->CIK mapping file changes rarely; a long TTL avoids re-fetching
# the ~800KB file on every symbol lookup.
SEC_TICKER_CIK_CACHE_TTL_SECONDS=604800

# --- Phase H.3: dataset-specific provider selection ---
# Explicit, per-capability, never a single "the" provider. Each is
# independently configurable ("yahoo" / "sec" / "alphavantage" as
# applicable) — see docs/security/YAHOO_SEC_PROVIDER_REVIEW.md §3.
FINANCE_QUOTE_PROVIDER=yahoo
FINANCE_PRICE_HISTORY_PROVIDER=yahoo
FINANCE_CORPORATE_ACTIONS_PROVIDER=yahoo
FINANCE_US_FUNDAMENTALS_PROVIDER=sec
FINANCE_COMPANY_PROFILE_PROVIDER=yahoo
FINANCE_ANALYST_ESTIMATES_PROVIDER=yahoo
FINANCE_NEWS_PROVIDER=alphavantage
FINANCE_SECONDARY_PROVIDER=alphavantage
# Whether a primary-provider failure may silently try the secondary provider.
# False by default: per-dataset provider is always reported, and a fallback
# that happened is always visible in the report rather than invisible.
FINANCE_AUTOMATIC_FALLBACK=false

# --- Finance extraction layer ---
# v1 (default) | compare | v2
#   v1      regex extraction only. No model call, no cost.
#   compare run both, RETURN V1'S ANSWER, record the disagreement. Diagnostic.
#   v2      return V2's answer; fails closed when the semantic read fails.
# compare and v2 need a model client registered at the composition root
# (assistant.py); without one they report NO_EXTRACTOR_REGISTERED rather than
# silently behaving like v1.
FINANCE_EXTRACTION_MODE=v1

# --- Reported Actuals Source Integration ---
# v1 (default) | compare | v2
# Whether filed EARNINGS-RELEASE EXHIBITS are read as a source of reported
# actual results, alongside the SEC CompanyFacts path. The Actualization
# resolver already chooses correctly between a newer complete Q4/FY release
# and an older Q3 10-Q; what it could not do was SEE the release, because an
# 8-K earnings exhibit is almost never represented in CompanyFacts.
#   v1      fetches nothing and produces no candidate.
#   compare reads the releases and RECORDS what it found without offering the
#           candidates. A compare mode that changed which period was selected
#           would be v2 by default wearing a diagnostic's name.
#   v2      offers the candidates to the existing resolver, and fails closed.
# This switch alone changes nothing: under FINANCE_ACTUALIZATION_MODE=v1, the
# production default, the actualization runtime returns before it looks at any
# candidate. Two switches, and the second is the one that changes an answer.
FINANCE_REPORTED_ACTUALS_MODE=v1
# How many candidate earnings filings one run may read. Each costs a filing
# index and an exhibit, both through the shared SEC cache.
FINANCE_REPORTED_ACTUALS_MAX_FILINGS=3
# Output-token ceiling per section. Sized for a REASONING model: thinking
# tokens never appear in message.content, and a 548-char section measured at
# 7210 tokens. The wall-clock timeout is derived from this value.
FINANCE_EXTRACTION_MAX_OUTPUT_TOKENS=20000
