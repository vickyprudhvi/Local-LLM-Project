venv/
memory/
snapshots/
artifacts/
logs/
data/
.env
__pycache__/
*.pyc
.pytest_cache/
ptt_capture.wav
vad_capture.wav
.claude/
credentials.json
token.json
# MCP test workspace: keep the seed file, ignore anything written during runs/tests
test_workspace/*
!test_workspace/hello.txt
# MCP configured-server workspace: keep the seed file, ignore runtime-written files
mcp_workspaces/test/*
!mcp_workspaces/test/hello.txt
mcp_workspaces/filesystem/*
!mcp_workspaces/filesystem/hello.txt
# Locally-installed external MCP servers (node_modules etc.) — never commit these
external_mcp_servers/
# Phase F managed state: node_modules, generated server.json / permissions.json /
# install-record.json / current.json, the installed-server registry, and install
# logs. All machine-specific. Keep only the directory placeholder.
app_data/mcp_servers/*
!app_data/mcp_servers/.gitkeep
# Local, machine-specific MCP configuration (point MCP_CONFIG_PATH at it)
config/mcp_server.local.json
config/*.local.json
# Phase F manual-test workspace
mcp_workspaces/user_files/
# npm dependency trees anywhere in the tree
**/node_modules/
# Local test scratch dirs / logs
f1_cli_test_2/
f1_external_test/
fixture_verify.log
# Phase H.1 market-data cache and quota ledger. Machine-specific, re-fetchable,
# and never to be committed (they hold provider responses, not secrets, but there
# is no reason for them to be in the repository).
app_data/finance_cache/

# Live extraction-benchmark model responses. A local measurement cache,
# not source: it is keyed on model identity and would go stale on any model
# change, and it holds raw model output.
app_data/extraction_benchmark_cache.json
