{
  "catalog_version": 1,
  "servers": {
    "official-filesystem": {
      "server_id": "filesystem",
      "display_name": "Filesystem MCP Server",
      "description": "Read and modify files inside explicitly approved directories.",
      "capabilities": [
        "filesystem",
        "read_files",
        "write_files",
        "list_directories",
        "search_files"
      ],
      "risk_category": "local_filesystem",
      "transport": "stdio",
      "required_runtimes": [
        "node",
        "npm"
      ],
      "installer": {
        "type": "npm",
        "package": "@modelcontextprotocol/server-filesystem",
        "version": "2026.7.10",
        "entrypoint": "node_modules/@modelcontextprotocol/server-filesystem/dist/index.js"
      },
      "required_inputs": [
        {
          "name": "allowed_directory",
          "type": "directory",
          "required": true,
          "user_approval_required": true
        }
      ],
      "expected_tools": [
        "list_allowed_directories",
        "list_directory",
        "read_text_file"
      ],
      "default_tool_policy": {
        "default_permission": "denied",
        "tools": {
          "list_allowed_directories": {
            "enabled": true,
            "permission": "read"
          },
          "list_directory": {
            "enabled": true,
            "permission": "read"
          },
          "list_directory_with_sizes": {
            "enabled": true,
            "permission": "read"
          },
          "directory_tree": {
            "enabled": true,
            "permission": "read"
          },
          "read_text_file": {
            "enabled": true,
            "permission": "read"
          },
          "read_multiple_files": {
            "enabled": true,
            "permission": "read"
          },
          "search_files": {
            "enabled": true,
            "permission": "read"
          },
          "get_file_info": {
            "enabled": true,
            "permission": "read"
          },
          "write_file": {
            "enabled": true,
            "permission": "write"
          },
          "create_directory": {
            "enabled": true,
            "permission": "write"
          },
          "move_file": {
            "enabled": false,
            "permission": "denied"
          },
          "edit_file": {
            "enabled": false,
            "permission": "denied"
          }
        }
      },
      "granular_capabilities": [
        "read_local_text_file",
        "read_multiple_local_files",
        "list_local_directory",
        "search_local_files",
        "get_local_file_metadata",
        "write_local_file",
        "create_local_directory",
        "manage_local_files"
      ],
      "selection_hints": {
        "explicit_names": [
          "filesystem",
          "filesystem mcp",
          "local files"
        ],
        "actions": {
          "read_local_text_file": [
            "read",
            "open",
            "show contents",
            "display contents",
            "view",
            "cat"
          ],
          "read_multiple_local_files": [
            "read multiple files",
            "read all files"
          ],
          "list_local_directory": [
            "list",
            "list directory",
            "list folder",
            "show files",
            "folder contents",
            "browse folder",
            "browse"
          ],
          "search_local_files": [
            "find",
            "find file",
            "search",
            "search files",
            "locate file"
          ],
          "get_local_file_metadata": [
            "file info",
            "file metadata",
            "file size",
            "file details"
          ],
          "write_local_file": [
            "write file",
            "save file",
            "create file",
            "write",
            "save"
          ],
          "create_local_directory": [
            "create directory",
            "create folder",
            "make directory",
            "make folder"
          ],
          "manage_local_files": [
            "copy",
            "move",
            "delete",
            "rename"
          ]
        },
        "extensions": {
          "read_local_text_file": [
            ".txt",
            ".md",
            ".json",
            ".yaml",
            ".yml",
            ".py",
            ".sql",
            ".csv",
            ".log",
            ".ini",
            ".toml",
            ".xml"
          ]
        }
      }
    },
    "official-markitdown": {
      "server_id": "markitdown",
      "display_name": "Microsoft MarkItDown MCP",
      "description": "Convert approved local documents to markdown. Curated local-format dependencies only; cloud, YouTube, and audio extras are intentionally omitted.",
      "capabilities": [
        "document_to_markdown"
      ],
      "risk_category": "local_document_conversion",
      "transport": "stdio",
      "required_runtimes": [
        "python"
      ],
      "installer": {
        "type": "python_venv",
        "package": "markitdown-mcp",
        "version": "0.0.1a4",
        "lock_file": "config/mcp_locks/markitdown-mcp-0.0.1a4.txt",
        "python_constraint": ">=3.10",
        "install_options": {
          "no_deps": true
        }
      },
      "launch": {
        "entrypoint_type": "python_module",
        "module": "markitdown_mcp"
      },
      "lock_environment": {
        "python_version": "3.13",
        "platform": "win_amd64"
      },
      "expected_tools": [
        "convert_to_markdown"
      ],
      "default_tool_policy": {
        "default_permission": "denied",
        "tools": {
          "convert_to_markdown": {
            "enabled": true,
            "permission": "read"
          }
        }
      },
      "granular_capabilities": [
        "document_to_markdown"
      ],
      "selection_hints": {
        "explicit_names": [
          "markitdown",
          "document to markdown",
          "convert document"
        ],
        "actions": {
          "document_to_markdown": [
            "convert",
            "to markdown",
            "read document",
            "document to text"
          ]
        },
        "extensions": {
          "document_to_markdown": [
            ".txt",
            ".html",
            ".htm",
            ".pdf",
            ".docx",
            ".pptx",
            ".xls",
            ".xlsx"
          ]
        }
      },
      "candidate_validator": "markitdown_local_document_v1",
      "invocation_policy": {
        "argument_mode": "exact_file_uri"
      },
      "enabled": true
    },
    "official-edgartools": {
      "server_id": "edgartools",
      "display_name": "EdgarTools SEC Research MCP",
      "description": "Read-only conversational SEC EDGAR research: company lookup, filing discovery, filing section text, and disclosure search. Evaluated in Phase H.22 and registered in Phase H.23 for agent-facing research only -- the automated FinancialDocumentPackage pipeline continues to use its own SEC fetcher and does not consume this server.",
      "capabilities": [
        "sec_filing_research"
      ],
      "risk_category": "network_sec_filing_research",
      "transport": "stdio",
      "required_runtimes": [
        "python"
      ],
      "installer": {
        "type": "python_venv",
        "package": "edgartools",
        "version": "5.58.0",
        "lock_file": "config/mcp_locks/edgartools-5.58.0.txt",
        "python_constraint": ">=3.10"
      },
      "launch": {
        "entrypoint_type": "console_script",
        "console_script": "edgartools-mcp"
      },
      "lock_environment": {
        "python_version": "3.13",
        "platform": "win_amd64"
      },
      "required_inputs": [
        {
          "name": "EDGAR_IDENTITY",
          "type": "environment_variable",
          "required": true,
          "user_approval_required": true
